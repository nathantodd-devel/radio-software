<?xml version="1.0" encoding="utf-8" ?>
<!--
  The app is one activity, MainActivity (gpui-mobile's GpuiActivity with the
  Back button and closing handled for a scanner), which loads the
  Rust library named by `nativeLibraryName` in build.gradle.kts and lets it
  drive everything from there.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- For importing channels from RadioReference. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- To keep scanning and playing when the app isn't in front (see
         PlaybackService), and to show the notification that says it is. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The phone has to be able to act as a USB host for the receiver. -->
    <uses-feature android:name="android.hardware.usb.host" android:required="true" />

    <!-- Vulkan is preferred; without it the renderer falls back to OpenGL ES. -->
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" android:version="0" />
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" android:version="0x00401000" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/GpuiTheme"
    >

        <!-- configChanges keeps the activity (and the Rust side with it) from
             being recreated on rotation and the like. -->
        <activity
            android:name="com.fairhouse.dmps.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified"
            android:theme="@style/GpuiSplashTheme"
            android:windowSoftInputMode="adjustResize"
        >
            <!-- The Rust library to load, without "lib" or ".so". -->
            <meta-data android:name="android.app.lib_name" android:value="${nativeLibraryName}" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Offer to open when an Airspy is plugged in; accepting also
                 grants the app permission to use it. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter"
            />
        </activity>

        <!-- Keeps the scanner running and audible in the background. -->
        <service
            android:name="com.fairhouse.dmps.PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
        />
        <!-- Importing and editing systems, with Android's own text fields. -->
        <activity
            android:name="com.fairhouse.dmps.SystemEditor"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault"
            android:windowSoftInputMode="adjustResize"
        />
        <!-- Helper activities gpui-mobile uses for file pickers, runtime
             permissions and biometric prompts. -->
        <activity
            android:name="dev.gpui.mobile.GpuiPickerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <activity
            android:name="dev.gpui.mobile.GpuiPermissionActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />
        <activity
            android:name="dev.gpui.mobile.GpuiAuthActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
        />

    </application>

</manifest>
